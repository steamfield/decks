{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && NODE_OPTIONS=--conditions=@steamfield/decks/source node_modules/.bin/tsx packages/node/src/cli/cli.ts hook lint || exit 2"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && NODE_OPTIONS=--conditions=@steamfield/decks/source node_modules/.bin/tsx packages/node/src/cli/cli.ts hook prompt"
          }
        ]
      }
    ]
  }
}
