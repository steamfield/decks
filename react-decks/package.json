{
  "name": "react-decks",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test",
    "check:isolated": "node scripts/check-isolated.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@testing-library/react": "16.3.3",
    "jsdom": "31.0.1",
    "@testing-library/user-event": "14.6.10",
    "@testing-library/jest-dom": "7.0.1"
  }
}
