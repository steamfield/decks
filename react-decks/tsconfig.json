{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    "customConditions": ["@steamfield/decks/source"],
    "jsx": "react-jsx",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "packages/*/src",
    "tests",
    "examples",
    "e2e",
    "playwright.config.ts",
    "vitest.setup.ts",
    "vitest.config.ts"
  ]
}
