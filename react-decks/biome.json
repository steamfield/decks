        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["*", "!./**", "!../**"],
                    "message": "Imports must follow the core package boundary."
                  },
                  {
                    "group": ["@react-decks/*/**"],
                    "message": "Use bare workspace package names; subpaths are private."
                  }
                ],
                "paths": {
                  "@react-decks/core": "The core package must not depend on @react-decks/core.",
                  "@react-decks/runtime": "The core package must not depend on @react-decks/runtime.",
