                  "@react-decks/kit": "The core package must not depend on @react-decks/kit."
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "DOM globals are forbidden in core.",
                  "document": "DOM globals are forbidden in core.",
