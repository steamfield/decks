{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker serving the static build; production is decks.steamfield.io
  // (see AGENTS.md, Deploy). Cloudflare's Git integration (Workers Builds) runs
  // `bun run build` (make build, which prepares the decks under WORKERS_CI) and
  // then `npx wrangler deploy` from site/ on every push to main.
  "name": "decks",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "decks.steamfield.io", "custom_domain": true }],
}
