---
import { docHref, type NavGroup, type NavItem, type OutlineItem } from "../lib/docs";
import { ruleCss } from "../lib/tokens";
import PageOutline from "../components/docs/PageOutline.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  markdown?: string;
  nav: NavGroup[];
  /** The page's doc id; omitted on the docs home. */
  current?: string;
  /** The page's h2s for the sidebar. */
  outline?: OutlineItem[];
  prev?: NavItem | undefined;
  next?: NavItem | undefined;
}
const { nav, current, outline = [], prev, next, ...page } = Astro.props;
---

<BaseLayout {...page}>
  <style is:inline set:html={ruleCss()} />
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-10 lg:grid-cols-[14rem_1fr]">
    <!-- Mobile: a <details> menu that opens without JavaScript. -->
    <details class="border-line rounded-lg border lg:hidden">
      <summary class="cursor-pointer px-4 py-2 font-medium">Docs menu</summary>
      <nav aria-label="Docs menu" class="px-4 pb-4">
        {nav.map((group) => (
          <div class="mt-4">
            <p class="text-muted text-xs font-semibold uppercase">{group.label}</p>
            <ul class="mt-2 space-y-1">
              {group.items.map((item) => (
                <li>
                  <a
                    href={docHref(item.id)}
                    aria-current={item.id === current ? "page" : undefined}
                    class="block"
                  >
                    {item.label}
                  </a>
                  {item.id === current && outline.length > 0 && <PageOutline outline={outline} />}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </details>
    <nav
      aria-label="Docs"
      class="docs-sticky hidden self-start overflow-y-auto text-sm lg:sticky lg:top-6 lg:block"
    >
      {nav.map((group) => (
        <div class="mb-6">
          <p class="text-muted text-xs font-semibold uppercase">{group.label}</p>
          <ul class="mt-2 space-y-1">
            {group.items.map((item) => (
              <li>
                <a
                  href={docHref(item.id)}
                  aria-current={item.id === current ? "page" : undefined}
                  class="aria-[current=page]:font-medium text-ink-2 hover:text-ink block no-underline"
                >
                  {item.label}
                </a>
                {item.id === current && outline.length > 0 && <PageOutline outline={outline} />}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <article class="docs-article min-w-0">
      <div class="prose max-w-none">
        <h1>{page.title}</h1>
        <slot />
      </div>
      {page.markdown && (
        <p class="text-muted mt-10 flex gap-4 text-sm">
          <a href={page.markdown}>View as Markdown</a>
          <button
            type="button"
            data-copy-page={page.markdown}
            hidden
            class="underline-offset-4 hover:underline"
          >
            Copy page
          </button>
        </p>
      )}
      {(prev || next) && (
        <nav aria-label="Pagination" class="docs-pager">
          {prev && (
            <a href={docHref(prev.id)} rel="prev">
              <span class="docs-pager-dir">
                <span class="docs-pager-arrow" aria-hidden="true">
                  ←
                </span>{" "}
                Previous
              </span>
              <span class="docs-pager-title">{prev.label}</span>
            </a>
          )}
          {next && (
            <a href={docHref(next.id)} rel="next" class="docs-pager-next">
              <span class="docs-pager-dir">
                Next{" "}
                <span class="docs-pager-arrow" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="docs-pager-title">{next.label}</span>
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
