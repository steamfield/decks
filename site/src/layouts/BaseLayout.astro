---
import { Font } from "astro:assets";
import Logo from "../components/Logo.astro";
import { site } from "../config";
import { softwareJsonLd } from "../lib/blog";
import { landingCss } from "../lib/tokens";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Route path with its trailing slash, e.g. "/docs/" (never Astro.url, which a host can rewrite). */
  path: string;
  /** Social card path under /og/. */
  image?: string;
  /** This page's Markdown export, linked as rel="alternate". */
  markdown?: string;
  noindex?: boolean;
  /** The landing page: dark only, in the product's own colors, with no theme toggle. */
  landing?: boolean;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description = site.description,
  path,
  image = "/og/index.png",
  markdown,
  noindex = false,
  landing = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;
const canonical = new URL(path, site.url);
const ogImage = new URL(image, site.url);
const isHome = path === "/";
const pageTitle = isHome ? site.title : `${title} | ${site.name}`;
const structuredData = [
  ...(isHome
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: site.name,
          alternateName: site.packageName,
          url: canonical.href,
        },
        softwareJsonLd(),
      ]
    : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en" class={landing ? "dark" : undefined} data-page={landing ? "landing" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Decks blog" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "max-snippet:-1, max-image-preview:large"}
    />
    {structuredData.map((data) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(data).replaceAll("<", "\\u003c")}
      />
    ))}
    <Font cssVariable="--ff-inter" preload />
    <Font cssVariable="--ff-mono" />
    {landing && <style is:inline set:html={landingCss()} />}
    <script is:inline>
      // Before paint: mark JavaScript on, then the stored theme, else the system
      // preference. The landing page is dark only and arrives with .dark set.
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        if (root.dataset.page === "landing") return;
        try {
          const stored = localStorage.getItem("theme");
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          root.classList.add(dark ? "dark" : "light");
        } catch {
          // Storage blocked: the CSS media fallback applies.
        }
      })();
    </script>
    <script>
      import { createConsentStore, mountConsentBanner } from "@steamfield/ui/consent";
      import { initAnalytics } from "../lib/analytics";
      import "../scripts/site";

      // A build without a key ships no analytics or consent code: this branch is
      // dropped. One sf-consent cookie on .steamfield.io covers every Steamfield site.
      const key = import.meta.env.PUBLIC_POSTHOG_KEY;
      if (key) {
        const consent = createConsentStore({ domain: "steamfield.io" });
        initAnalytics({
          key,
          host: import.meta.env.PUBLIC_POSTHOG_HOST,
          site: "decks",
          consent,
        });
        mountConsentBanner(consent, {
          message:
            "The Decks site counts visits and clicks with PostHog. Accept lets it set cookies so repeat visits count once, and turns on session recordings and heatmaps.",
          privacyHref: "https://steamfield.io/privacy",
        });
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-canvas sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:p-2"
    >
      Skip to content
    </a>
    <slot name="banner" />
    {landing ? (
      <>
        <div data-header-sentinel aria-hidden="true" class="h-px" />
        <header class="landing-header" data-landing-header>
          <div class="page-column landing-nav">
            <a href="/" class="text-ink flex items-center gap-2 no-underline">
              <Logo />
              <span class="text-lg font-semibold tracking-tight">{site.name}</span>
            </a>
            {site.version && <span class="version-chip">v{site.version}</span>}
            <nav aria-label="Main">
              <a href="#examples">Examples</a>
              <a href="/docs/">Docs</a>
              <a href="/blog/">Blog</a>
              {site.social.map((link) => (
                <a href={link.href} class="nav-wide">
                  {link.label}
                </a>
              ))}
              <a href="#install" class="nav-install">
                Install
              </a>
            </nav>
          </div>
        </header>
      </>
    ) : (
      <header class="border-line border-b">
        <div class="mx-auto flex h-14 max-w-[1200px] items-center gap-2 px-4 sm:gap-4 sm:px-8">
          <a href="/" class="text-ink flex items-center gap-2 no-underline">
            <Logo />
            <span class="text-lg font-semibold tracking-tight">{site.name}</span>
            <span class="text-muted hidden font-mono text-xs sm:inline">{site.packageName}</span>
          </a>
          {site.version && (
            <span class="text-muted hidden font-mono text-xs sm:inline">v{site.version}</span>
          )}
          <nav aria-label="Main" class="ml-auto flex items-center gap-3 text-sm sm:gap-5">
            <a href="/docs/" class="no-underline hover:underline">
              Docs
            </a>
            <a href="/blog/" class="no-underline hover:underline">
              Blog
            </a>
            {site.social.map((link) => (
              <a href={link.href} class="no-underline hover:underline">
                {link.label}
              </a>
            ))}
          </nav>
          <!-- Search goes here: a search fragment fills this slot. -->
          <slot name="search" />
          <button
            type="button"
            data-theme-toggle
            hidden
            class="border-line-strong text-ink-2 hover:text-ink rounded-sm border px-2 py-1 text-xs"
          >
            Dark theme
          </button>
        </div>
      </header>
    )}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class:list={["border-line text-muted border-t text-sm", { "bg-band": landing }]}>
      <div
        class:list={[
          "grid gap-8 sm:grid-cols-[1.4fr_1fr_1fr_1fr]",
          landing ? "page-column py-16" : "mx-auto max-w-[1200px] px-4 py-10 sm:px-8",
        ]}
      >
        <div class="flex flex-col gap-2">
          <span class="text-ink font-semibold">{site.name}</span>
          <span>A Steamfield project.</span>
          <span>Released under the {site.license} license.</span>
          <a
            href="https://steamfield.io/privacy"
            class="text-muted hover:text-ink w-fit no-underline hover:underline"
          >
            Privacy
          </a>
          {site.version && <span class="font-mono text-xs">v{site.version}</span>}
        </div>
        {site.footer.map((column) => (
          <div class="flex flex-col gap-2">
            <span class="text-ink font-medium">{column.title}</span>
            {column.links.map((link) => (
              <a href={link.href} class="text-muted hover:text-ink no-underline hover:underline">
                {link.label}
              </a>
            ))}
          </div>
        ))}
      </div>
    </footer>
  </body>
</html>
