---
import type { GetStaticPaths } from "astro";
import { docsGroups } from "../../config";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getDocs, getDocEntries, render } from "../../lib/collection";
import { docHref, docsNav, markdownHref, ogImageHref, pageLinks } from "../../lib/docs";

export const getStaticPaths = (async () => {
  const entries = await getDocEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const nav = docsNav(await getDocs(), docsGroups);
const { prev, next } = pageLinks(nav, entry.id);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  path={docHref(entry.id)}
  image={ogImageHref(entry.id)}
  markdown={markdownHref(entry.id)}
  nav={nav}
  current={entry.id}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>
