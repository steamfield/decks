---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { Code } from "astro:components";
import CopyBlock from "../components/CopyBlock.astro";
import TypeSwitch from "../components/TypeSwitch.astro";
import { DeckPlayer } from "../components/landing/DeckPlayer";
import { InstallTabs } from "../components/landing/InstallTabs";
import {
  CompareTable,
  DeckProse,
  FitLists,
  Hero,
  HookPanel,
  JCard,
  ReleaseBanner,
  Requirements,
  Section,
  Transcript,
} from "../components/landing/sections";
import { site } from "../config";
import { loadHookDenial, loadSmokeRun } from "../data/fixtures";
import { loadTapes } from "../data/tapes";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Events } from "../lib/events";

const tapes = loadTapes();
const [tides] = tapes;
const run = loadSmokeRun();
const denial = loadHookDenial();
const warmTheme = readFileSync(join(process.cwd(), "demo/warm-theme.json"), "utf8");
const codeThemes = { light: "github-light", dark: "github-dark-default" } as const;
---

<BaseLayout title={site.tagline} path="/">
  <ReleaseBanner slot="banner" announcement={site.announcement} />

  <section aria-labelledby="hero-title">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-10 px-4 pt-14 pb-16 sm:px-8 sm:pt-20">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-end">
        <div id="hero-title">
          <Hero tagline={site.tagline} description={site.description} />
        </div>
        <div class="flex flex-col gap-3">
          <CopyBlock
            lines={site.quickstart}
            label="Copy both install commands"
            track={Events.installCopied}
            trackMethod="hero"
          />
          <p class="text-muted text-sm">
            Copy both lines: without the install, <code>bunx decks</code> fetches an unrelated npm
            package.
          </p>
          <p class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
            <a href="/docs/getting-started/quickstart/">Read the docs</a>
            <a href={site.repo}>GitHub</a>
          </p>
        </div>
      </div>
      <DeckPlayer
        client:visible
        tapes={tapes}
        changesHref={`${site.repo}/compare/97b8a6b...main`}
      />
      {tides && <DeckProse tape={tides} />}
    </div>
  </section>

  <Section
    id="fit"
    title="Does it fit my setup?"
    lede="Decks is a layer on Slidev with one base theme and dark slides. Check this before anything else."
  >
    <FitLists yes={site.fit.yes} no={site.fit.no} />
    <p class="text-ink-2 mt-6">
      Already have a Slidev deck?{" "}
      <a href="/docs/getting-started/add-decks-to-an-existing-deck/">
        Add Decks to an existing Slidev deck
      </a>
      .
    </p>
  </Section>

  <Section
    id="why"
    title="Why not v-click and a chart library?"
    lede="Slidev's v-click reveals elements one click at a time. A story slide ties the whole chart to the click count."
  >
    <CompareTable rows={site.compare} />
  </Section>

  <Section
    id="box"
    title="What's in the box?"
    lede="The npm package is side A. Side B lives in the repository: tools that check a deck, and the agent setup."
  >
    <JCard title={`Decks ${site.version}`} a={site.jcard.a} b={site.jcard.b} />
  </Section>

  <Section
    id="theme"
    title="Can it look like mine?"
    lede="Every color, font and brand field comes from one theme file. A deck's theme.json overrides only the keys it names."
  >
    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
      <TypeSwitch />
      <div class="flex flex-col gap-3">
        <figure class="code-frame">
          <figcaption>theme.json (WARM)</figcaption>
          <Code code={warmTheme} lang="json" themes={codeThemes} defaultColor={false} />
        </figure>
        <p class="text-muted text-sm">
          Surfaces and the two hues the tides deck draws with, from the example decks' warm palette.
          <a href="/docs/guides/theming-with-theme-json/">Theming with theme.json</a>
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="agent"
    title="Can my agent write one?"
    lede="The agent setup lives in the repository, not the npm package. Clone it and run Claude Code at its root."
  >
    <div class="flex flex-col gap-8">
      <CopyBlock
        lines={[site.clone, "cd decks", "bun install", "claude"]}
        label="Copy the clone commands"
      />
      <Transcript run={run} />
      <HookPanel denial={denial} />
      <p class="text-ink-2">
        <a href="/docs/guides/writing-decks-with-an-agent/">Writing decks with an agent</a> covers
        the agent, the skills, the rules and the hooks.
      </p>
    </div>
  </Section>

  <Section id="install" title="Install">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="flex flex-col gap-4">
        <InstallTabs client:visible options={site.install} />
        <p class="text-ink-2 text-sm">Then start the dev server:</p>
        <CopyBlock lines={site.afterInstall} label="Copy the dev command" />
      </div>
      <Requirements items={site.requirements} />
    </div>
  </Section>
</BaseLayout>
