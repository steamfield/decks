---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { Code } from "astro:components";
import CopyBlock from "../components/CopyBlock.astro";
import TypeSwitch from "../components/TypeSwitch.astro";
import { DeckPlayer } from "../components/landing/DeckPlayer";
import { InstallTabs } from "../components/landing/InstallTabs";
import {
  CompareTable,
  DeckProse,
  FitLists,
  Hero,
  HookPanel,
  JCard,
  ReleaseBanner,
  Requirements,
  Section,
  Transcript,
} from "../components/landing/sections";
import { site } from "../config";
import { loadHookDenial, loadSmokeRun } from "../data/fixtures";
import { loadTapes } from "../data/tapes";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Events } from "../lib/events";

const tapes = loadTapes();
const [tides] = tapes;
const run = loadSmokeRun();
const denial = loadHookDenial();
const warmTheme = readFileSync(join(process.cwd(), "demo/warm-theme.json"), "utf8");
const codeThemes = { light: "github-light-high-contrast", dark: "github-dark-default" } as const;
---

<BaseLayout title={site.tagline} path="/">
  <ReleaseBanner slot="banner" announcement={site.announcement} />

  <section aria-labelledby="hero-title" class="hero-room">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-10 px-4 pt-14 pb-16 sm:px-8 sm:pt-20">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:items-end">
        <div id="hero-title">
          <Hero tagline={site.tagline} description={site.description} />
        </div>
        <div class="flex flex-col gap-3">
          <CopyBlock
            lines={site.quickstart}
            label="Copy both install commands"
            track={Events.installCopied}
            trackMethod="hero"
          />
          <p class="text-muted text-sm">
            Run both lines together. The <code>decks</code> package on npm is unrelated, so{" "}
            <code>bunx decks</code> only finds this one after the install.
          </p>
          <p class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
            <a href="/docs/getting-started/quickstart/">Read the docs</a>
            <a href={site.repo}>GitHub</a>
          </p>
        </div>
      </div>
      <DeckPlayer
        client:visible
        tapes={tapes}
        changesHref={`${site.repo}/compare/97b8a6b...main`}
      />
      {tides && <DeckProse tape={tides} />}
    </div>
  </section>

  <Section
    id="fit"
    title="Requirements and limits"
    lede="Decks runs on Slidev with one base theme, slidev-theme-the-unnamed, and every slide is dark."
  >
    <FitLists yes={site.fit.yes} no={site.fit.no} />
    <p class="text-ink-2 mt-6">
      To use Decks in a deck you already have, see{" "}
      <a href="/docs/getting-started/add-decks-to-an-existing-deck/">
        Add Decks to an existing Slidev deck
      </a>
      .
    </p>
  </Section>

  <Section
    id="why"
    title="Compared with v-click"
    lede="Slidev's v-click shows or hides one element per click. A story slide redraws the whole chart from the current click count."
  >
    <CompareTable rows={site.compare} />
  </Section>

  <Section
    id="box"
    title="What's included"
    lede="Side A is the npm package. Side B is the repository, which adds screenshot tools, example decks and the Claude Code setup."
  >
    <JCard title={`Decks ${site.version}`} a={site.jcard.a} b={site.jcard.b} />
  </Section>

  <Section
    id="theme"
    title="Themes"
    lede="Colors, fonts and cover branding come from one theme file. A deck's theme.json sets only the keys it lists, and the rest keep their defaults."
  >
    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem] [&>*]:min-w-0">
      <TypeSwitch />
      <div class="flex min-w-0 flex-col gap-3">
        <figure class="code-frame code-wrap">
          <figcaption>theme.json (WARM)</figcaption>
          <Code code={warmTheme} lang="json" themes={codeThemes} defaultColor={false} />
        </figure>
        <p class="text-muted text-sm">
          This file changes the background colors and the two chart colors the tides deck uses. The
          values come from the warm palette in the template deck.{" "}
          <a href="/docs/guides/theming-with-theme-json/">Theming with theme.json</a>
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="agent"
    title="Writing decks with Claude Code"
    lede="The agent setup is in the repository, not the npm package: an agent, two skills, writing rules and a lint hook. Clone the repository and run Claude Code from its root."
  >
    <div class="flex flex-col gap-8">
      <CopyBlock
        lines={[site.clone, "cd decks", "bun install", "claude"]}
        label="Copy the clone commands"
      />
      <Transcript run={run} />
      <HookPanel denial={denial} />
      <p class="text-ink-2">
        <a href="/docs/guides/writing-decks-with-an-agent/">Writing decks with an agent</a> explains
        each piece and how to run it.
      </p>
    </div>
  </Section>

  <Section id="install" title="Install">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="flex flex-col gap-4">
        <InstallTabs client:idle options={site.install} />
        <p class="text-ink-2 text-sm">Then start the dev server:</p>
        <CopyBlock lines={site.afterInstall} label="Copy the dev command" />
      </div>
      <Requirements items={site.requirements} />
    </div>
  </Section>
</BaseLayout>
