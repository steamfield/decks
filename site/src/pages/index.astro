---
import ThemeCompare from "../components/blog/ThemeCompare.astro";
import CopyBlock from "../components/CopyBlock.astro";
import { DeckPlayer } from "../components/landing/DeckPlayer";
import { InstallTabs } from "../components/landing/InstallTabs";
import {
  CompareTable,
  DeckProse,
  ExampleGallery,
  FileTree,
  HookPanel,
  ReleaseBanner,
  Requirements,
  Section,
  Transcript,
} from "../components/landing/sections";
import { agents, countWord, site } from "../config";
import { ENTRIES, loadExamples } from "../data/examples";
import { loadHookDenial, loadRun, runFigures } from "../data/fixtures";
import { loadProjectFiles, setupCommands } from "../data/project";
import "../styles/landing.css";
import BaseLayout from "../layouts/BaseLayout.astro";

const examples = loadExamples();
const [hero] = examples;
const agentEntry = ENTRIES.find((entry) => entry.name === "keeling");
const agentExample = examples.find((example) => example.name === "keeling");
const agentRun = agentEntry?.run ? loadRun(agentEntry.run.fixture) : null;
const agentFigures = agentRun ? runFigures(agentRun) : null;
const denial = loadHookDenial();
const files = loadProjectFiles();
---

<BaseLayout title={site.tagline} path="/" landing>
  <ReleaseBanner slot="banner" announcement={site.announcement} />

  <section aria-labelledby="hero-title" class="hero">
    <div class="page-column hero-head">
      <div>
        <h1 id="hero-title" class="hero-title hero-in">
          {site.tagline}
        </h1>
        <p class="hero-lede hero-in" style="--delay: 120ms">
          {site.heroDescription}
        </p>
      </div>
      <div class="hero-intro hero-in" style="--delay: 240ms">
        <CopyBlock
          id="copy-copy-the-install-commands"
          lines={site.quickstart}
          label="Copy the install commands"
          track="install_copied"
          trackMethod="hero"
        />
        <div class="hero-actions">
          <a class="button-primary" href="#install">
            Install Decks
          </a>
          <a class="button-secondary" href="/docs/getting-started/quickstart/">
            Read the quickstart <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="hero-fineprint">{site.heroFineprint}</p>
      </div>
    </div>
    <div class="page-column hero-in-media" style="--delay: 360ms">
      <DeckPlayer client:visible examples={examples} priority gallery />
    </div>
    {hero && <DeckProse example={hero} />}
  </section>

  {agentRun && agentFigures && agentExample && (
    <Section
      id="agent"
      tone="band"
      title={`Claude Code drafted this deck from one prompt in ${agentFigures.minutes} minutes.`}
      lede="The Keeling curve deck below came from a fresh project set up with the commands above, then a second Claude Code session revised it."
    >
      <div class="agent-evidence">
        <div class="agent-prompt">
          <p class="evidence-label">The prompt</p>
          <blockquote>{agentRun.prompt}</blockquote>
          <dl class="run-figures">
            <div>
              <dt>Draft time</dt>
              <dd>{agentFigures.minutes} min</dd>
            </div>
            <div>
              <dt>Claude usage</dt>
              <dd>{agentFigures.cost}</dd>
            </div>
            <div>
              <dt>Agent turns</dt>
              <dd>{agentFigures.turns}</dd>
            </div>
          </dl>
          <p class="agent-links">
            <a href={agentExample.href} data-example={agentExample.name}>
              Load the Keeling deck in the player <span aria-hidden="true">→</span>
            </a>
            <a href="/docs/guides/writing-decks-with-an-agent/">
              Writing decks with an agent <span aria-hidden="true">→</span>
            </a>
          </p>
          <HookPanel denial={denial} />
        </div>
        <Transcript run={agentRun} deck="the Keeling curve deck" />
      </div>
    </Section>
  )}

  <Section
    id="install"
    title="Install it, then ask your agent for a deck."
    lede={`The ${site.packageName} package adds slide components, agent guidance and a story-deck scaffold to your project.`}
  >
    <div class="getting-started-grid">
      <div class="install-block" data-block>
        <InstallTabs client:idle options={site.install} />
        <p class="text-muted text-sm">
          Decks is free and {site.license} licensed. Claude usage is billed separately.
        </p>
      </div>
      <dl class="workflow">
        <div>
          <dt>Describe the talk</dt>
          <dd>Give your coding agent the topic, audience and the story you want to tell.</dd>
        </div>
        <div>
          <dt>Review the draft</dt>
          <dd>
            Watch the deck locally with <code>{site.devCommand}</code>. Ask for changes to a slide
            or chart.
          </dd>
        </div>
        <div>
          <dt>Check the sources</dt>
          <dd>
            Run <code>fact-checking-a-deck</code> before presenting. Each figure stays linked to its
            source.
          </dd>
        </div>
      </dl>
    </div>
    <details class="evidence-disclosure" id="what-you-get">
      <summary>
        Files created by the setup <span>Agent instructions, deck scaffold and source map</span>
      </summary>
      <div class="disclosure-content">
        <FileTree files={files} notes={site.files} commands={setupCommands} />
      </div>
    </details>
    <p class="text-ink-2">
      <a href="/docs/getting-started/quickstart/">Follow the quickstart</a> for the full setup.
    </p>
  </Section>

  <Section
    id="examples"
    tone="band"
    title="Every example is a deck you can open and edit."
    lede="Pick one to load it into the player at the top of the page. Each row says how the deck was made."
  >
    <ExampleGallery examples={examples} />
    <details class="evidence-disclosure">
      <summary>
        Story slides and v-click <span>How the presentation advances</span>
      </summary>
      <div class="disclosure-content">
        <p class="text-ink-2 mb-4">
          Slidev's v-click shows or hides one element per click. A story slide redraws the chart
          from the current click count.
        </p>
        <CompareTable rows={site.compare} />
      </div>
    </details>
  </Section>

  <Section
    id="themes"
    title="One theme.json restyles every slide."
    lede="Colors, fonts and cover branding come from one theme file. A deck's theme.json sets only the keys it lists, and the rest keep their defaults."
  >
    <ThemeCompare />
  </Section>

  <Section
    id="requirements"
    tone="band"
    title="Requirements and limits"
    lede={`Decks runs on Slidev with shared instructions for ${countWord(agents.length)} agent platforms.`}
  >
    <div class="requirements-grid">
      <Requirements items={site.requirements} />
      <div class="docs-links">
        <h3>Documentation</h3>
        <a href="/docs/getting-started/quickstart/">
          Start a new deck <span aria-hidden="true">→</span>
        </a>
        <a href="/docs/getting-started/add-decks-to-an-existing-deck/">
          Add Decks to an existing Slidev deck <span aria-hidden="true">→</span>
        </a>
        <a href="/docs/guides/writing-decks-with-an-agent/">
          Write with an agent <span aria-hidden="true">→</span>
        </a>
        <a href="/docs/guides/theming-with-theme-json/">
          Customize the theme <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </Section>

  <section class="closing-cta" aria-label="Install Decks">
    <div class="page-column closing-row" data-reveal>
      <p class="closing-line">
        {site.license ? `Decks is free under the ${site.license} license.` : "Decks is free."}
      </p>
      <div class="hero-actions">
        <a class="button-primary" href="#install">
          Install Decks
        </a>
        <a class="button-secondary" href="/docs/getting-started/quickstart/">
          Read the quickstart <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
