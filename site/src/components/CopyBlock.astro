---
// One or more command lines with a single copy button that copies them all.
// The button stays hidden until src/scripts/site.ts wires it (enhanceCopyButtons
// from @steamfield/ui/copy, which copies the <code>'s text); without JavaScript the
// commands are plain selectable text. The "$ " prompts are drawn by CSS
// (.copy-line::before), so they are never copied.
import type { EventName } from "../lib/events";

interface Props {
  /** The <code>'s id, which the button names; unique on the page. */
  id: string;
  lines: string[];
  /** Accessible name for the button, e.g. "Copy both install commands". */
  label: string;
  track?: EventName;
  trackMethod?: string;
}
const { id, lines, label, track, trackMethod } = Astro.props;
---

<div class="border-line-strong bg-panel flex flex-wrap items-start gap-3 rounded-md border p-3">
  <pre class="text-ink min-w-0 flex-1 font-mono text-[13px] leading-6 whitespace-pre-wrap"><code id={id}>{
    lines.map((line, index) => (
      <span class="copy-line block pl-[2ch] -indent-[2ch]">{
        // A long line wraps only between words, never inside a package name or a
        // flag, and the continuation hangs under the command.
        line.split(" ").map((word, i) => (
          <>{i > 0 ? " " : ""}<span class="whitespace-nowrap">{word}</span></>
        ))
      }{index < lines.length - 1 ? "\n" : ""}</span>
    ))
  }</code></pre>
  <button
    type="button"
    hidden
    data-copy-command
    aria-controls={id}
    data-track={track}
    data-track-method={trackMethod}
    aria-label={label}
    class="border-line-strong text-ink-2 hover:text-ink min-h-11 shrink-0 rounded-sm border px-3 text-xs"
  >
    <span data-copy-label>Copy</span>
  </button>
  {/* A failure message takes its own row under the commands. */}
  <span data-copy-result role="status" aria-live="polite" class="basis-full"></span>
</div>
