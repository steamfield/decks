---
// The NORMAL/WARM switch: the same tides slide built with the default theme and
// with demo/warm-theme.json, both screenshots taken by `make demo`. Two radio
// inputs and CSS, so it works without JavaScript; site.ts only records a change.
import { existsSync } from "node:fs";
import { join } from "node:path";

const positions = [
  { value: "normal", label: "Normal", note: "packages/decks/theme/default.json" },
  { value: "warm", label: "Warm", note: "default.json with theme.json on top" },
];
const base = (value: string) => `/stills/tides-${value}`;
const exists = (value: string) =>
  existsSync(join(process.cwd(), "public", `${base(value)}-1280.avif`));
const srcset = (value: string, ext: string) =>
  [640, 1280].map((width) => `${base(value)}-${width}.${ext} ${width}w`).join(", ");
---

<div class="type-switch flex flex-col gap-4">
  <fieldset class="faceplate type-panel">
    <legend class="sr-only">Tape type</legend>
    <span class="legend" aria-hidden="true">
      Tape type
    </span>
    <div class="type-track">
      {positions.map((position, index) => (
        <label class="type-position">
          <input
            type="radio"
            name="tape-type"
            value={position.value}
            checked={index === 0}
            data-tape-type
            class="peer sr-only"
          />
          <span class="led" aria-hidden="true" data-color="amber" />
          <span class="legend">{position.label}</span>
        </label>
      ))}
      <span aria-hidden="true" class="type-knob"></span>
    </div>
    <span class="legend type-note" data-note="normal">
      {positions[0]?.note}
    </span>
    <span class="legend type-note" data-note="warm">
      {positions[1]?.note}
    </span>
  </fieldset>
  {positions.map((position) => (
    <figure data-still={position.value} class="flex flex-col gap-2">
      {exists(position.value) ? (
        <picture>
          <source
            type="image/avif"
            srcset={srcset(position.value, "avif")}
            sizes="(min-width: 1280px) 640px, 100vw"
          />
          <source
            type="image/webp"
            srcset={srcset(position.value, "webp")}
            sizes="(min-width: 1280px) 640px, 100vw"
          />
          <img
            src={`${base(position.value)}-1280.webp`}
            width="1280"
            height="720"
            loading="lazy"
            alt={`The tides deck's second slide with the ${position.label.toLowerCase()} theme`}
            class="border-line aspect-video w-full rounded-sm border"
          />
        </picture>
      ) : (
        <p class="border-line text-muted grid aspect-video place-items-center rounded-sm border text-sm">
          Run make demo to take this still.
        </p>
      )}
      <figcaption class="text-muted text-sm">
        {position.label}: {position.note}
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .type-switch:has(input[value="warm"]:checked) [data-still="normal"],
  .type-switch:not(:has(input[value="warm"]:checked)) [data-still="warm"],
  .type-switch:has(input[value="warm"]:checked) [data-note="normal"],
  .type-switch:not(:has(input[value="warm"]:checked)) [data-note="warm"] {
    display: none;
  }

  .type-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
  }

  .type-track {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 4px;
    border-radius: 3px;
    background: #050506;
    box-shadow:
      inset 0 1px 4px #000,
      0 1px 0 rgb(255 255 255 / 0.08);
  }

  .type-position {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    min-width: 6.5rem;
    cursor: pointer;
  }

  .type-position:has(:checked) .led {
    background: #ffb52e;
    box-shadow: 0 0 6px 1px rgb(255 181 46 / 0.6);
  }

  .type-position:has(:checked) .legend {
    color: #18191b;
  }

  .type-knob {
    position: absolute;
    inset: 4px auto 4px 4px;
    width: calc(50% - 4px);
    border-radius: 2px;
    background: var(--brushed), linear-gradient(180deg, #f3f3f4, #a9abaf);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.7),
      0 2px 0 #0c0c0d;
  }

  .type-switch:has(input[value="warm"]:checked) .type-knob {
    transform: translateX(100%);
  }

  .type-track:has(input:focus-visible) {
    outline: 2px solid var(--color-live);
    outline-offset: 3px;
  }

  .type-note {
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (prefers-reduced-motion: no-preference) {
    .type-knob {
      transition: transform 160ms ease-out;
    }
  }
</style>
