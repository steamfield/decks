---
// Rendered on a docs page whose guide has demo fences: the landing's dark tokens for the
// player stage, the player's stylesheet (a client script's CSS imports are not linked), and the
// script that mounts live players over the posters.
import { landingCss } from "../../lib/tokens";
import "../../styles/player.css";
import "../../styles/deck-demos.css";
---

<style is:inline set:html={landingCss(undefined, ".deck-demo-stage")}></style>
<script>
  // Docs pages have no React island, so Astro never adds React's refresh preamble; without it the
  // dev server throws "can't detect preamble" and the players never mount. Empty in a build.
  import "@vitejs/plugin-react/preamble";
  import { mountDeckDemos } from "../../scripts/deck-demos";
  mountDeckDemos();
</script>
