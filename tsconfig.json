{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/decks/**/*.ts",
    "packages/decks/**/*.mts",
    "examples/*/components/**/*.ts",
    "examples/*/data/**/*.ts",
    "examples/*/setup/**/*.ts",
    "decks/*/components/**/*.ts",
    "decks/*/data/**/*.ts",
    "decks/*/setup/**/*.ts"
  ]
}
