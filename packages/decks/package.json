{
  "name": "@steamfield/decks",
  "version": "1.3.1",
  "description": "React slide decks for animated, data-driven talks: MDX slides, motion, story stages, charts, and a CLI, built with coding agents.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steamfield/decks.git",
    "directory": "packages/decks"
  },
  "homepage": "https://decks.steamfield.io",
  "bugs": "https://github.com/steamfield/decks/issues",
  "keywords": [
    "slides",
    "presentations",
    "react",
    "mdx",
    "vite",
    "data-storytelling",
    "charts"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "@steamfield/decks/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./motion": {
      "@steamfield/decks/source": "./src/motion.ts",
      "types": "./dist/motion.d.ts",
      "default": "./dist/motion.js"
    },
    "./kit": {
      "@steamfield/decks/source": "./src/kit.ts",
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    },
    "./node": {
      "@steamfield/decks/source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./kit/styles.css": {
      "@steamfield/decks/source": "./src/kit/styles.css",
      "default": "./dist/kit/styles.css"
    }
  },
  "bin": {
    "decks": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "3d-force-graph": "1.80.1",
    "@mdx-js/rollup": "3.1.1",
    "@opendata-ai/openchart-core": "9.0.0",
    "@opendata-ai/openchart-react": "9.0.0",
    "@shikijs/magic-move": "4.6.0",
    "@shikijs/rehype": "4.6.0",
    "@types/d3-scale": "4.0.9",
    "@types/mdx": "2.0.14",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/xterm": "6.0.0",
    "citty": "0.2.2",
    "d3-scale": "4.0.2",
    "get-port": "7.2.0",
    "gray-matter": "4.0.3",
    "gsap": "3.15.1",
    "jiti": "2.7.0",
    "oxc-parser": "0.158.0",
    "picocolors": "1.1.1",
    "playwright-core": "1.65.1",
    "react-error-boundary": "6.1.6",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "roughjs": "4.6.6",
    "shiki": "4.6.0",
    "three": "0.185.1",
    "three-spritetext": "1.10.0",
    "tinyglobby": "0.2.17",
    "tinykeys": "4.0.1",
    "unified": "11.0.5",
    "uqr": "0.1.3",
    "vite": "8.3.8",
    "ws": "8.18.3",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@react-decks/core": "workspace:*",
    "@react-decks/runtime": "workspace:*",
    "@react-decks/motion": "workspace:*",
    "@react-decks/node": "workspace:*",
    "@react-decks/kit": "workspace:*"
  }
}
