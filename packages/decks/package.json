{
  "name": "slidev-addon-decks",
  "version": "0.1.0",
  "description": "Slidev addon: story engine, ink marks, OpenChart wrapper, layout CSS, and a deck runner.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "slidev-addon",
    "slidev"
  ],
  "engines": {
    "slidev": ">=52"
  },
  "exports": {
    "./package.json": "./package.json",
    "./story": "./story/index.ts",
    "./chart-theme": "./chart-theme.ts",
    "./composables/*": "./composables/*.ts",
    "./theme": "./theme/index.ts"
  },
  "imports": {
    "#decks/theme": "./theme/default.ts"
  },
  "bin": {
    "decks": "./scripts/deck.mjs"
  },
  "files": [
    "LICENSE",
    "chart-theme.ts",
    "vite.config.mts",
    "components",
    "composables",
    "global-bottom.vue",
    "public",
    "setup",
    "theme",
    "!theme/*.test.ts",
    "styles",
    "story",
    "!story/*.test.ts",
    "!story/test-decks.ts",
    "viewer",
    "templates",
    "lint",
    "!lint/*.test.*",
    "agent",
    "!agent/INVENTORY.md",
    "scripts",
    "!scripts/*.test.ts",
    "!scripts/embed-check.mjs",
    "!scripts/render-agent.mjs",
    "!scripts/render-agent.d.mts",
    "!scripts/tarball-e2e.mjs",
    "!scripts/viewer-browser.mjs"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@opendata-ai/openchart-core": "9.0.0",
    "@opendata-ai/openchart-vue": "9.0.0",
    "d3-scale": "^4.0.2",
    "gsap": "^3.15.0",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "pixelmatch": ">=6",
    "playwright-chromium": ">=1.40",
    "pngjs": ">=7"
  },
  "peerDependenciesMeta": {
    "pixelmatch": {
      "optional": true
    },
    "playwright-chromium": {
      "optional": true
    },
    "pngjs": {
      "optional": true
    }
  }
}
